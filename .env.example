# Copia este fichero como ".env" y rellena los valores.
# Interruptor único de la parte online. Todo (página /online, sincronización)
# depende de él a través de GET /api/salud.
SERVER_ON=false

# URL pública canónica del sitio (sin barra final); se usa para metadata y sitemap.
# Ejemplo: https://miconvoy.example
NEXT_PUBLIC_SITE_URL=

# Conexión a MySQL. En local apunta al Docker (npm run db:up); en el futuro
# apuntará al servidor real sin cambiar código.
DATABASE_URL="mysql://usuario:clave@localhost:3306/miconvoy"

# Client ID de Google Identity Services. Es necesario para iniciar sesión en el
# servidor y habilitar sincronización y publicación online. El perfil local
# también se puede crear con correo y nombre aunque se deje vacío.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Opcional: clave SOLO de servidor para OpenRouteService (autocompletado y km).
# Sin ella, la calculadora sigue funcionando con km manuales.
ORS_API_KEY=
# Límites por IP para llamadas no cacheadas, por instancia de servidor activa.
ORS_MAX_REQUESTS_PER_MINUTE=30
ORS_MAX_REQUESTS_PER_DAY=250

# Opcional: API key completa (Root) de Ably para el tiempo real online.
# El navegador solo recibe tokens temporales por viaje, nunca esta key.
ABLY_API_KEY=
