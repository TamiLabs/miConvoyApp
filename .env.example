# Se deja en false para que el despliegue inicial (Netlify, Modo Free) no
# muestre ni intente conectar con la parte online.
NEXT_PUBLIC_SERVER_ENABLED=false

# Solo hace falta cuando el servidor (Modo Online) está activo.
DATABASE_URL="postgresql://miconvoy:miconvoy@localhost:5432/miconvoy"

# Opcional: client ID de Google Identity Services para el botón real de Google
# en /perfil. Si se deja vacío, se usa el formulario local de correo + nombre.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
