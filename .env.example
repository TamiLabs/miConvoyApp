# Copia este fichero como ".env" y rellena los valores.
# Interruptor único de la parte online. Todo (página /online, sincronización)
# depende de él a través de GET /api/salud.
SERVER_ON=false

# Conexión a MySQL. En local apunta al Docker (npm run db:up); en el futuro
# apuntará al servidor real sin cambiar código.
DATABASE_URL="mysql://usuario:clave@localhost:3306/miconvoy"

# Opcional: client ID de Google Identity Services para el botón real de Google
# en /perfil. Si se deja vacío, se usa el formulario local de correo + nombre.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Opcional: clave SOLO de servidor para OpenRouteService (autocompletado y km).
# Sin ella, la calculadora sigue funcionando con km manuales.
ORS_API_KEY=
